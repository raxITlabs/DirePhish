# DirePhish backend (Flask + ADK runner + MCP world servers).
# Also serves the A2A Containment Judge — same dependency tree; Cloud Run
# overrides the command to uvicorn for the judge service.
#
# Build context MUST be the repo ROOT: the simulation runs as a subprocess
# `python -m backend.adk.runner`, which requires `backend` to be importable
# (hence PYTHONPATH=/app below).
FROM python:3.11-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# uv must be on PATH at runtime: the app shells out to `uv run` for the sim
# subprocess and the stdio MCP world servers.
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

ENV UV_NO_CACHE=1 \
    FLASK_DEBUG=false \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    PYTHONPATH=/app

WORKDIR /app/backend

# Dependency layer (cached unless the lockfile changes). Creates
# /app/backend/.venv — the interpreter the MCP toolset factory prefers.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen

# App layer — full repo so `backend.adk.runner` + `adk` / `app` / `mcp_servers`
# all resolve. The root .dockerignore trims node_modules, frontend, venvs, etc.
COPY . /app

EXPOSE 8080

# 1 gunicorn worker (in-process SSE bus + sim-subprocess state live in ONE
# process) × many gthread threads (each open SSE connection holds a thread).
# Cloud Run injects $PORT; --timeout 0 because Cloud Run enforces the real
# request timeout (set to 3600s on the service).
CMD ["sh", "-c", "exec uv run python -m gunicorn --worker-class gthread --workers 1 --threads 16 --timeout 0 --graceful-timeout 30 --access-logfile - --error-logfile - --bind 0.0.0.0:${PORT} wsgi:app"]
