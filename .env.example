# ============================================================================
# ADK simulation core — Google Vertex AI (REQUIRED)
# ----------------------------------------------------------------------------
# The agent simulation (ADK orchestrator, personas, judge, A2A) runs entirely
# on Vertex AI via Application Default Credentials. No API key is baked in.
# Auth locally:  gcloud auth application-default login
# On Cloud Run:  the runtime service account provides ADC automatically.
# ============================================================================
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini 3.x lives on the global endpoint (regional carries only 2.5).
GOOGLE_CLOUD_LOCATION=global

# Model tiers (override per-tier; bump here when new IDs land — no code change).
# Defenders run on Flash (3.5 = GA agentic workhorse); adversary + judge on Pro.
GEMINI_PRO_MODEL_NAME=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL_NAME=gemini-3.5-flash

# Adversary provider: 'gemini' (default) or 'claude'. Claude is dormant —
# only flip to 'claude' if Anthropic Model Garden is enabled on this project.
THREAT_ACTOR_PROVIDER=gemini
# Claude tiers (optional — only used when THREAT_ACTOR_PROVIDER=claude):
# CLAUDE_SONNET_MODEL_NAME=claude-sonnet-4-5

# A2A Containment Judge: set to the deployed judge URL to score cross-process.
# Unset → judge runs in-process. (judge_service publishes its card from A2A_PUBLIC_URL.)
# A2A_JUDGE_URL=https://direphish-judge-xxxx.run.app

# Observability: export OpenTelemetry spans to Cloud Trace.
# CLOUD_TRACE_ENABLED=true
# Disable per-round Firestore writes (CI / local-only runs):
# DIREPHISH_FIRESTORE_ENABLED=false

# ===== Firestore Vector Search (simulation memory) =====
# GCP project above must have Firestore Native mode enabled (run scripts/create_firestore_indexes.sh).
# FIRESTORE_DATABASE=(default)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768

# ===== Cloudflare Browser Rendering (web crawling) =====
# Account ID: https://dash.cloudflare.com/ → ID in URL after /accounts/
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
# API Token: create with "Browser Rendering - Edit" permission
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# ===== Simulation config =====
OASIS_DEFAULT_MAX_ROUNDS=3
# MONTE_CARLO_MAX_WORKERS=3
# GEMINI_RPM_LIMIT=60

# ============================================================================
# Legacy (non-ADK) research/report/Monte-Carlo pipeline
# ----------------------------------------------------------------------------
# Migrated to the unified google-genai SDK on Vertex (uses the ADC + project
# above). LLM_API_KEY / LLM_BASE_URL are no longer required for these routes.
# ============================================================================
# LLM_MODEL_NAME=gemini-3.5-flash
# LLM_PRO_MODEL=gemini-3.1-pro-preview

# ===== Frontend / Docker (optional) =====
# Backend URL for Next.js server-side calls (Docker Compose sets this automatically):
# FLASK_API_URL=http://127.0.0.1:5001
# Docker Compose published host ports (defaults 3000 / 5001):
# HOST_PORT_FRONTEND=3010
# HOST_PORT_BACKEND=5010
